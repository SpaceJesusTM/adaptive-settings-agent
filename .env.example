# Copy to `.env` (same folder) and adjust. `.env` is git-ignored and machine-local.

# --- Local model (Ollama, called only from the backend) ---------------------------------------
# Where Ollama listens. Default for Ollama running on the same machine (Windows or macOS):
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set this to the EXACT tag shown by `ollama list` - do not guess a tag. Example used in this project:
#   gemma4:12b-it-q4_K_M   (Gemma 4 12B instruct, Q4_K_M; see docs/MODEL_SETUP.md)
# Leave empty to run with the clearly labelled offline fallback only.
OLLAMA_MODEL=
# Per-request timeout (seconds) and the overall deadline for one assistant turn.
OLLAMA_TIMEOUT=90
AGENT_DEADLINE_S=150
# Generation parameters. OLLAMA_THINK=true enables the model's reasoning mode (slower, sometimes better).
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
# Maximum rounds of read-only tool calls the model may request per turn, and deterministic grounding fast-path.
AGENT_MAX_TOOL_ROUNDS=2
AGENT_FAST_PATH=true

# --- Local servers ---------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
FRONTEND_PORT=5173
# Optional comma-separated browser origins for direct API access. Vite uses a same-origin proxy.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Storage (relative paths resolve against this project folder) -----------------------------
CSC2524_DB_PATH=data/local/app.db
# Set to false to stop persisting chat text (traces keep only a 120-character excerpt).
STORE_CHAT_HISTORY=true
